# Zoeys Billiard House SPA routing
RewriteEngine On
Options -Indexes

# Hardening: no direct web access to internals
RewriteRule ^(?:includes|database|backups)/ - [F,L]
RewriteRule ^config\.php$ - [F,L]

# SPA API calls (/api/ajax/...) -> PHP ajax handlers
RewriteRule ^api/ajax/(.*)$ ajax/$1 [L,QSA]

# Built frontend files (dist/) served at the project root
RewriteRule ^logo\.png$ dist/logo.png [L]
RewriteRule ^assets/(.*)$ dist/assets/$1 [L,QSA]

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Never cache HTML/API responses: index.html references hashed asset names
  # that change on every build. A stale cached copy loads chunk files that no
  # longer exist, which makes lazy routes (e.g. Reports) render blank until a
  # hard refresh.
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
  Header always set Expires "0"

  # Hashed build assets are content-addressed and can be cached aggressively.
  <FilesMatch "\.(js|css|woff2?|png|svg|jpg|jpeg|gif|ico)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Hide PHP version banner (Apache mod_php)
<IfModule mod_php.c>
  php_flag expose_php Off
</IfModule>